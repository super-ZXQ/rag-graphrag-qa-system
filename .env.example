# 复制为 .env.local 后填写；.env.local 已被 Git 忽略。
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=90
OPENALEX_API_KEY=
OPENALEX_MAILTO=
QDRANT_COLLECTION_VERSION=v1
QDRANT_COLLECTION=papers_v1
# 不运行 Qdrant 服务时可启用本地持久化；Docker 环境请保持为空。
QDRANT_PATH=

# 仅在 LLM_PROVIDER=ollama 时使用。
LLM_MODEL=qwen2.5:7b

# Docker Compose 默认仅绑定 127.0.0.1；远程部署应放在具备 TLS、认证与 RBAC 的反向代理后。
HOST_BIND=127.0.0.1
# 官方 PyPI 不稳定时可临时改为可信镜像；默认保持官方源。
PIP_INDEX_URL=https://pypi.org/simple
NEO4J_PASSWORD=change-me-123
