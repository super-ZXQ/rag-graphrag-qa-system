# 复制为 .env.local 后填写；.env.local 已被 Git 忽略。
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
OPENALEX_API_KEY=
OPENALEX_MAILTO=
QDRANT_COLLECTION_VERSION=v1
QDRANT_COLLECTION=papers_v1
# 不运行 Qdrant 服务时可启用本地持久化；Docker 环境请保持为空。
QDRANT_PATH=

# 仅在 LLM_PROVIDER=ollama 时使用。
LLM_MODEL=qwen2.5:7b

NEO4J_PASSWORD=change-me-123
